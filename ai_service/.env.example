# ---- AI provider for the news-feed recommender (replaces local Ollama) ----

# Provider: "openai" (OpenAI-compatible, default) or "anthropic" (Claude)
AI_PROVIDER=openai

# Model name for the chosen provider.
#   OpenAI:    gpt-4o-mini
#   Groq:      llama-3.3-70b-versatile
#   OpenRouter:openai/gpt-4o-mini
#   Anthropic: claude-3-5-haiku-latest
AI_MODEL=gpt-4o-mini

# --- OpenAI-compatible providers (OpenAI / Groq / OpenRouter / Together...) ---
OPENAI_API_KEY=
# Default: https://api.openai.com/v1
# Groq:       https://api.groq.com/openai/v1
# OpenRouter: https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic (only used when AI_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=

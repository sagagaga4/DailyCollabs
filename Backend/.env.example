# Backend configuration

# Port the Express server listens on
PORT=4000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/dailycollabsdb
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/dailycollabsdb
MONGO_URI=mongodb://127.0.0.1:27017/dailycollabsdb

# Secret used to sign JWT auth tokens (use a long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# URL of the Python AI service (news-feed recommender)
AI_SERVICE_URL=http://127.0.0.1:5000

# Public URL of THIS backend (used for internal self-calls).
# Leave unset for local dev. In production set to your deployed backend URL.
# SELF_URL=https://your-backend.onrender.com

# Public frontend origin for comment/repost links
FRONTEND_URL=http://localhost:5173

# Optional official YouTube Data API key. Without it, public search is best-effort.
YOUTUBE_API_KEY=
